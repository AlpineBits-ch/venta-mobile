	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<!-- ITSAppUsesNonExemptEncryption is deliberately ABSENT. That means "ask me
	     in App Store Connect", and answering the questionnaire per build is
	     currently the price of shipping. Read docs/export-compliance.md before
	     touching this.

	     It cannot be false. The app ships its own cryptography rather than only
	     calling Apple's: venta_mls links OpenMLS (RFC 9420) for end-to-end
	     message encryption, and WebRTC.framework carries BoringSSL for
	     DTLS-SRTP. Neither is covered by the exemptions, which are for
	     HTTPS/CryptoKit/Keychain, authentication-only use, or DRM. It said
	     false until 2026-08-01 - a false declaration, which is why no build was
	     ever asked.

	     It cannot be a bare true either. **Tried twice, failed twice**, on
	     2026-08-01 and again on 2026-08-02 in v1.0.57:

	       [altool] Invalid Export Compliance Code. The export compliance key
	       value [] in the app's Info.plist doesn't match the key value of the
	       app's export compliance documentation. (90592)

	     The empty [] is the missing ITSEncryptionExportComplianceCode. altool
	     requires a matching code whenever this key is true, and it does not
	     care that Apple's own documentation table says our case needs no
	     document. That table
	     (developer.apple.com/help/app-store-connect/reference/
	     export-compliance-documentation-for-encryption) maps us to "industry
	     standard algorithm, not provided within the Apple operating system",
	     whose only document is the French declaration, itself footnoted as
	     required only when distributing in France. We do not. CCATS covers only
	     *proprietary* algorithms and every primitive here is published - HPKE,
	     X25519, Ed25519, AES-GCM, ChaCha20-Poly1305, HKDF - a self-classified
	     ECCN 5D992.c mass market item. By that reading a bare true should work.
	     It does not. Believe altool, not the table.

	     So the only way to stop the per-build questionnaire is to obtain a real
	     code: upload documentation under App Information -> App Encryption
	     Documentation ("Hochladen"), wait for Apple to approve it, then pin the
	     returned value here as ITSEncryptionExportComplianceCode NEXT TO a
	     true. Both keys or neither.

	     Never resolve a 90592 by flipping this to false. -->
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSCameraUsageDescription</key>
	<string>Venta needs camera access to take a photo for your profile picture or server banner, and to share your camera in calls.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Venta needs microphone access for voice calls.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Venta needs photo library access so you can choose a profile picture or server banner.</string>
	<key>NSUserNotificationsUsageDescription</key>
	<string>Venta needs notification access to alert you about new messages and incoming calls.</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<!-- Wakes the app for incoming-call VoIP pushes (PushKit) so CallKit
		     can be shown before the OS kills the app for taking too long. -->
		<string>voip</string>
		<!-- Regular message push notifications while backgrounded. -->
		<string>remote-notification</string>
		<!-- Keeps an active call's audio session alive while backgrounded. -->
		<string>audio</string>
	</array>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
