<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Venta</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Venta</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<!-- Invite links, notification-tap deep links - see
				     lib/core/routing/deep_link_handler.dart. -->
				<string>venta</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<!-- ITSAppUsesNonExemptEncryption is deliberately absent, which means "ask
	     me in App Store Connect" rather than making a claim here.

	     It cannot be false: the app ships its own cryptography rather than only
	     calling Apple's. venta_mls links OpenMLS (RFC 9420) for end-to-end
	     message encryption, and WebRTC.framework carries BoringSSL for
	     DTLS-SRTP. Neither is covered by the exemptions, which are for
	     HTTPS/CryptoKit/Keychain, authentication-only use, or DRM. It said
	     false until 2026-08-01, which is why no build was ever asked.

	     It cannot be true on its own either - altool then demands a matching
	     ITSEncryptionExportComplianceCode and rejects the upload with

	       Invalid Export Compliance Code ... key value [] ... (90592)

	     and that code only exists after a declaration in App Store Connect,
	     which needs an uploaded build. Absent breaks the loop: the build
	     uploads, App Store Connect marks it Missing Compliance, you answer the
	     questionnaire once, and the code it returns can then be pinned here
	     alongside a true.

	     All of the crypto is standard published algorithms - HPKE, X25519,
	     Ed25519, AES-GCM, ChaCha20-Poly1305, HKDF - so this is a
	     self-classified ECCN 5D992.c mass market item. Read
	     docs/export-compliance.md before touching either key. -->
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSCameraUsageDescription</key>
	<string>Venta needs camera access to take a photo for your profile picture or server banner, and to share your camera in calls.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Venta needs microphone access for voice calls.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Venta needs photo library access so you can choose a profile picture or server banner.</string>
	<key>NSUserNotificationsUsageDescription</key>
	<string>Venta needs notification access to alert you about new messages and incoming calls.</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<!-- Wakes the app for incoming-call VoIP pushes (PushKit) so CallKit
		     can be shown before the OS kills the app for taking too long. -->
		<string>voip</string>
		<!-- Regular message push notifications while backgrounded. -->
		<string>remote-notification</string>
		<!-- Keeps an active call's audio session alive while backgrounded. -->
		<string>audio</string>
	</array>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
