<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>aps-environment</key>
	<string>production</string>
	<!-- See Runner.entitlements - the extension reads MLS state from this
	     container to decrypt push notifications. This is the file the release
	     workflow signs against, so the App Store profile in
	     IOS_PROVISION_PROFILE_BASE64 must carry the App Groups capability. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.gg.venta.mobile</string>
	</array>
	<!-- See Runner.entitlements, including why the app's own group has to be
	     first. Both files have to carry this or the debug and release builds
	     disagree about where the MLS state key lives, and the one that is wrong
	     seals nothing while reporting success. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)gg.venta.mobile</string>
		<string>$(AppIdentifierPrefix)gg.venta.mobile.shared</string>
	</array>
</dict>
</plist>
